# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build

# testing
/coverage
/playwright-report/
/test-results/

# misc
.DS_Store
*.pem

# debug logs (npm-debug.log*, yarn-debug.log*, pnpm-debug.log*)
*.log

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# Generated by `next dev`/`next build`/`next typegen` and differs between them.
next-env.d.ts

# runtime data: SQLite database (WAL) + generated password/session secret
/data/

# local-only development notes
/ROADMAP*.md
/TODO*.md
/MEMORY*.md
/skills/
/docs/*roadmap*.md
/docs/*todo*.md
/docs/*memory*.md
/docs/todo-roadmap.md
/docs/repair-review.md
/docs/heroui-pro-upgrade.md
/docker-compose.ghcr*.yml
