# Optional. Set a 16-300 character password to preconfigure access and skip first-run setup.
BARKER_PASSWORD=
# Optional; if set, it is required for first-run setup. Use at least 32 random characters.
BARKER_SETUP_TOKEN=
# Optional, explicitly permits first-run setup without a token; use only on a restricted network.
BARKER_ALLOW_SETUP=
# Optional. If omitted, Rubidium stores a generated signing secret in the data directory.
BARKER_SESSION_SECRET=
# Relative to the launch directory, never the standalone directory. Must be outside .next.
BARKER_DATA_DIR=./data
# Optional. Set to 1 only when Rubidium runs behind a trusted reverse proxy,
# so X-Forwarded-For / X-Real-IP / X-Forwarded-Proto are honored for rate
# limiting and Secure cookies. Never enable when Rubidium is directly exposed.
BARKER_TRUST_PROXY=
# Optional. Force the Secure flag on the session cookie when TLS is terminated
# outside Rubidium but BARKER_TRUST_PROXY is not enabled. Defaults to following
# the trusted proxy's X-Forwarded-Proto only.
BARKER_COOKIE_SECURE=
# Docker Compose only. Listen locally by default; put HTTPS behind a reverse proxy.
BARKER_BIND_ADDR=127.0.0.1
BARKER_PORT=3000
