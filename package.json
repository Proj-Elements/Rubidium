{
  "name": "rubidium",
  "version": "0.4.2",
  "description": "Rubidium 是前后端一体的 Next.js 定时提醒工作空间，按 cron 周期将提醒可靠推送到自建 Bark API。",
  "author": "MournInk",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "TZ=Asia/Shanghai next dev",
    "build": "node scripts/build-preflight.mjs && next build && node scripts/verify-standalone.mjs",
    "start": "TZ=Asia/Shanghai node scripts/start-server.mjs .next/standalone/server.js",
    "lint": "eslint .",
    "test": "TZ=Asia/Shanghai node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:watch": "TZ=Asia/Shanghai node --import tsx --test --watch tests/*.test.ts tests/*.test.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "ui:setup": "node scripts/setup-heroui.mjs",
    "data:backup": "node scripts/data-tools.mjs backup",
    "data:restore": "node scripts/data-tools.mjs restore"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@heroui-pro/react": "1.0.0-beta.11",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@iconify-icons/gravity-ui": "2.0.2",
    "@iconify/react": "6.0.4",
    "@internationalized/date": "3.12.4",
    "@number-flow/react": "^0.6.2",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "croner": "^10.0.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "maplibre-gl": "^6.19.0",
    "marked": "^18.2.1",
    "motion": "^14.14.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "react-stately": "^3.51.0",
    "recharts": "^3.11.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.5",
    "heroui-setup": "1.0.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.14.0"
}
